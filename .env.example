# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own API keys and settings.
# Never commit your real `.env` with secrets!
# ──────────────────────────────────────────────────────────────────────────────

# Your OpenAI (or OpenAI-compatible) API key
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) If you’re pointing at a custom endpoint—e.g. Groq, AWS, Azure, etc.
#OPENAI_BASE_URL=https://api.yourprovider.com/v1/

# Which model to use (e.g. gpt-4, gpt-4o, qwen-qwq-32b, etc.)
LLM_NAME=your_model_name_here

# ──────────────────────────────────────────────────────────────────────────────

# LangSmith (LangChain) tracing
# Enable V2 tracing, set your endpoint, key, and project name:
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name_here

# ──────────────────────────────────────────────────────────────────────────────
